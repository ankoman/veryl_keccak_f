import Keccak::keccak_state;
import Keccak::W;

#[test(test_keccak_f)]
module test_keccak_f{

    inst clk: $tb::clock_gen#(period: 10);
    inst rst: $tb::reset_gen(clk);

    var dout: logic<W>;
    var busy: logic;
    var drdy: logic;
    var run: logic;
    var din_vld: logic;

    inst dut: Keccak_f(
        i_clk: clk,
        i_rst: rst,
        i_din: '0,
        i_run: run,
        i_din_vld: din_vld,
        o_busy: busy,
        o_drdy: drdy,
        o_dout: dout,
    );

    initial{
        run = 0;
        rst.assert();
        clk.next();
        run = 1;
        clk.next();
        run = 0;
        clk.next(100);
        for i in 0..25 {
            $display("state_A[%d] = %h", i, dout);
            din_vld = 1;
            clk.next();
        }
        $finish();
    }
}

