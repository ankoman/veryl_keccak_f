#[test(test_keccak_f, Keccak_f)]
embed (cocotb) py{{{
import cocotb
from cocotb.clock import Clock
from cocotb.triggers import RisingEdge


@cocotb.test()
async def test_keccak_f(dut):
    cocotb.start_soon(
        Clock(dut.i_clk, 10, unit="ns").start()
    )

    dut.i_run.value = 0

    dut.i_rst.value = 0
    await RisingEdge(dut.i_clk)

    dut.i_rst.value = 1

    for i in range(25):
        dut.i_din[i].value = 0
            
    dut.i_run.value = 1
    await RisingEdge(dut.i_clk)
    dut.i_run.value = 0

    for _ in range(100):
        await RisingEdge(dut.i_clk)

    for i in range(25):
        print(f"state_A[{i:2d}] = 0x{int(dut.state_A[i].value):016x}")
    
}}}