package Keccak{
    const B: u32 = 200;
    const W: u32 = B/25;
    const L: u32 = $clog2(W);

    type keccak_state = logic<W> [25];
    const rho_offset: u32 [25] = '{0,1,190,28,91,
                            36,300,6,55,276,
                            3,10,171,153,231,
                            105,45,15,21,136,
                            210,66,253,120,78};
    const rc_200: u8 [18] = '{
        8'h01, 8'h82, 8'h8A, 8'h00,
        8'h8B, 8'h01, 8'h81, 8'h09,
        8'h8A, 8'h88, 8'h09, 8'h0A,
        8'h8B, 8'h8B, 8'h89, 8'h03,
        8'h02, 8'h80
    };
    // function rotl(
    //     lane: input logic<W>,
    //     rot:  input u16,
    // ) -> logic<W> {
    //     if (rot == 0){
    //         return lane;
    //     } else{
    //         return {lane[msb - rot:0], lane[msb:msb - rot + 1]};
    //     }
    // }

    function theta(
        state_A: input keccak_state,
    ) -> keccak_state
    {
        var C_lane: logic<W> [5];
        for x in 0..5 {
            C_lane[x] = state_A[x] ^ state_A[x+5] ^ state_A[x+10] ^ state_A[x+15] ^ state_A[x+20];
        }
        var D_lane: logic<W> [5];
        for x in 0..5 {
            D_lane[x] = C_lane[(x + 4) % 5] ^ {C_lane[(x + 1) % 5][msb - 1:0], C_lane[(x + 1) % 5][msb]};
        }
        var temp_state: keccak_state;
        for idx in 0..25 {
            temp_state[idx] = state_A[idx] ^ D_lane[idx % 5];
        }
        return temp_state;
    }

    function rho(
        state_A: input keccak_state,
    ) -> keccak_state
    {
        var temp_state: keccak_state;
        for i in 0..25 {
            let rot: u32 = rho_offset[i] % W;
            temp_state[i] = (state_A[i] << rot) | (state_A[i] >> (W - rot));
        }
        return temp_state;
    }

    function pi(
        state_A: input keccak_state,
    ) -> keccak_state
    {
        var temp_state: keccak_state;
        for y in 0..5 {
            for x in 0..5 {
                let src: u32 = 5*y + x;
                let dst: u32 = 5*((2*x + 3*y) % 5) + y;
                temp_state[dst] = state_A[src];
            }
        }
        return temp_state;
    }

    function chi(
        state_A: input keccak_state,
    ) -> keccak_state
    {
        var temp_state: keccak_state;
        let mask: logic<W> = (1 << W) - 1;
        for y in 0..5 {
            for x in 0..5 {
                let idx1: u32 = 5*y + x;
                let idx2: u32 = 5*y + ((x+1) % 5);
                let idx3: u32 = 5*y + ((x+2) % 5);
                temp_state[idx1] = state_A[idx1] ^ ((state_A[idx2] ^ mask) & state_A[idx3]);
            }
        }
        return temp_state;
    }

    function iota(
        state_A: input keccak_state,
        sreg_ir: input logic<12+2*L>,
    ) -> keccak_state
    {
        var temp_state: keccak_state;
        var rc: u8;
        for i in 0..18 {
            if sreg_ir[i] {
                rc = rc_200[i];
            }
        }
        temp_state[0] = state_A[0] ^ rc;
        temp_state[1:24] = state_A[1:24];
        return temp_state;
    }
}

module Keccak_f (
    i_clk: input clock,
    i_rst: input reset,
    i_din: input Keccak::keccak_state,
    i_run: input logic,
    o_busy: output logic,
    o_drdy: output logic,
    o_dout: output Keccak::keccak_state,
){
    var state_A: Keccak::keccak_state;
    var sreg_ir: logic<12+2*Keccak::L>;

    always_ff {
        if_reset{
            sreg_ir = '0;
        } else if (i_run){
            sreg_ir[0] = 1'b1;
        } else {
            sreg_ir = {sreg_ir[msb-1:0], 1'b0};
        }
    }

    let A2t: Keccak::keccak_state = Keccak::theta(state_A);
    let t2r: Keccak::keccak_state = Keccak::rho(A2t);
    let r2p: Keccak::keccak_state = Keccak::pi(t2r);
    let p2c: Keccak::keccak_state = Keccak::chi(r2p);
    let i2A: Keccak::keccak_state = Keccak::iota(p2c, sreg_ir);
    
    always_ff{
        if_reset{
            state_A = '{default: '0};
        } else if (o_busy){
            state_A = i2A;
        }
    }

    assign o_busy = |sreg_ir;
    assign o_drdy = sreg_ir[msb];
    assign o_dout = state_A;
}
